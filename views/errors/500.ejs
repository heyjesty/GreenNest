<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="main" class="section">
  <div class="container">
    <div class="empty empty--page">
      <p class="empty__code"><%= status %></p>
      <h1 class="section-title section-title--sm"><%= status === 403 ? 'Access denied' : 'Something went wrong' %></h1>
      <p><%= message || 'An unexpected error occurred. Please try again in a moment.' %></p>
      <div class="success__actions"><a href="/" class="btn btn--dark">Back to Home</a></div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
