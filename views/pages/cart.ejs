<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">
  <%- include('../partials/page-hero', { bg: 'care', heading: 'Your Cart', breadcrumbs: [{ label: 'Cart' }] }) %>

  <section class="section">
    <div class="container">
      <% if (!summary.lines.length) { %>
        <div class="empty">
          <svg class="empty__svg"><use href="#i-cart"/></svg>
          <h2>Your cart is empty</h2>
          <p>Looks like you haven’t added any plants yet.</p>
          <a href="/shop" class="btn btn--dark">Start Shopping</a>
        </div>
      <% } else { %>
        <div class="cart">
          <form action="/cart/update" method="post" class="cart__items panel">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="cart__head">
              <span>Product</span><span>Quantity</span><span>Total</span>
            </div>
            <% summary.lines.forEach(l => { %>
              <div class="cart-line">
                <a href="/shop/<%= l.slug %>" class="cart-line__img"><img src="<%= l.image %>" alt=""></a>
                <div class="cart-line__info">
                  <a href="/shop/<%= l.slug %>" class="cart-line__name"><%= l.name %></a>
                  <span class="cart-line__price"><%= h.money(l.price) %></span>
                  <% if (l.requested > l.quantity) { %><span class="cart-line__note">Only <%= l.quantity %> available</span><% } %>
                </div>
                <div class="qty qty--sm" data-qty data-autosubmit>
                  <button type="button" data-step="-1" aria-label="Decrease quantity">−</button>
                  <input type="number" name="qty[<%= l.id %>]" value="<%= l.quantity %>" min="0" max="<%= Math.min(l.stock, 20) %>" aria-label="Quantity for <%= l.name %>">
                  <button type="button" data-step="1" aria-label="Increase quantity">+</button>
                </div>
                <strong class="cart-line__total"><%= h.money(l.lineTotal) %></strong>
                <button name="remove" value="<%= l.id %>" class="cart-line__remove" aria-label="Remove <%= l.name %>"><svg><use href="#i-trash"/></svg></button>
              </div>
            <% }) %>
            <div class="cart__footer">
              <a href="/shop" class="link">← Continue shopping</a>
              <button class="btn btn--ghost">Update Cart</button>
            </div>
          </form>

          <aside class="summary panel">
            <h2 class="panel__title">Order Summary</h2>
            <% if (summary.subtotal - summary.discount < summary.freeShippingOver) { %>
              <% const pct = Math.min(100, ((summary.subtotal - summary.discount) / summary.freeShippingOver) * 100); %>
              <div class="ship-meter">
                <p>Add <strong><%= h.money(summary.freeShippingOver - (summary.subtotal - summary.discount)) %></strong> more for free shipping</p>
                <div class="ship-meter__bar"><span style="width: <%= pct.toFixed(0) %>%"></span></div>
              </div>
            <% } else { %>
              <p class="ship-ok"><svg><use href="#i-truck"/></svg> You’ve unlocked free shipping!</p>
            <% } %>

            <dl class="totals">
              <div><dt>Subtotal (<%= summary.count %> item<%= summary.count > 1 ? 's' : '' %>)</dt><dd><%= h.money(summary.subtotal) %></dd></div>
              <% if (summary.coupon) { %>
                <div class="totals__discount"><dt>Discount (<%= summary.coupon.code %>)</dt><dd>−<%= h.money(summary.discount) %></dd></div>
              <% } %>
              <div><dt>Shipping</dt><dd><%= summary.shipping ? h.money(summary.shipping) : 'Free' %></dd></div>
              <div class="totals__grand"><dt>Total</dt><dd><%= h.money(summary.total) %></dd></div>
            </dl>

            <form action="/cart/coupon" method="post" class="coupon">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (summary.coupon) { %>
                <p class="coupon__applied"><svg><use href="#i-check"/></svg> <%= summary.coupon.code %> applied</p>
                <button name="remove" value="1" class="link">Remove</button>
              <% } else { %>
                <label for="code" class="sr-only">Coupon code</label>
                <input type="text" id="code" name="code" placeholder="Coupon code" class="input" autocomplete="off">
                <button class="btn btn--ghost">Apply</button>
              <% } %>
            </form>

            <a href="/cart/checkout" class="btn btn--dark btn--block btn--lg">Proceed to Checkout</a>
            <p class="summary__note"><svg><use href="#i-shield"/></svg> Secure checkout · Cash on delivery</p>
          </aside>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
