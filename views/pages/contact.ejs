<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const err = (k) => errors[k] ? `<span class="field__error">${errors[k]}</span>` : ''; %>

<main id="main">
  <%- include('../partials/page-hero', {
    bg: 'newsletter', heading: 'Get In Touch',
    subheading: 'Questions about an order or need advice for a tricky plant? We’re here to help you grow.',
    breadcrumbs: [{ label: 'Contact' }]
  }) %>

  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <div class="info-card">
          <span class="info-card__icon"><svg><use href="#i-mail"/></svg></span>
          <div><h3>Email</h3><a href="mailto:hello@greennest.com">hello@greennest.com</a></div>
        </div>
        <div class="info-card">
          <span class="info-card__icon"><svg><use href="#i-phone"/></svg></span>
          <div><h3>Phone</h3><a href="tel:+10000000000">+1 (000) 000-0000</a></div>
        </div>
        <div class="info-card">
          <span class="info-card__icon"><svg><use href="#i-pin"/></svg></span>
          <div><h3>Visit Us</h3><p>123 Greenhouse Lane<br>Garden City</p></div>
        </div>
        <div class="info-card">
          <span class="info-card__icon"><svg><use href="#i-clock"/></svg></span>
          <div><h3>Opening Hours</h3><p>Mon – Sat: 9:00 – 18:00<br>Sunday: Closed</p></div>
        </div>
      </div>

      <form action="/contact" method="post" class="panel contact__form" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h2 class="panel__title">Send Us a Message</h2>
        <p class="muted">We usually reply within 1–2 business days.</p>
        <div class="form-grid">
          <div class="field <%= errors.name ? 'has-error' : '' %>">
            <label for="name">Your name</label>
            <input id="name" name="name" class="input" value="<%= form.name || (user ? user.name : '') %>" required autocomplete="name">
            <%- err('name') %>
          </div>
          <div class="field <%= errors.email ? 'has-error' : '' %>">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" class="input" value="<%= form.email || (user ? user.email : '') %>" required autocomplete="email">
            <%- err('email') %>
          </div>
          <div class="field field--full <%= errors.subject ? 'has-error' : '' %>">
            <label for="subject">Subject</label>
            <input id="subject" name="subject" class="input" value="<%= form.subject || '' %>" required>
            <%- err('subject') %>
          </div>
          <div class="field field--full <%= errors.message ? 'has-error' : '' %>">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" class="input" required><%= form.message || '' %></textarea>
            <%- err('message') %>
          </div>
        </div>
        <button class="btn btn--dark btn--lg">Send Message</button>
      </form>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
