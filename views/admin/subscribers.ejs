<%- include('_top') %>
<section class="card">
  <div class="toolbar">
    <p class="muted"><%= subscribers.length %> subscribers</p>
    <a href="/admin/subscribers.csv" class="btn">Export CSV</a>
  </div>
  <% if (subscribers.length) { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Email</th><th>Subscribed</th><th></th></tr></thead>
      <tbody>
        <% subscribers.forEach(s => { %>
          <tr>
            <td data-label="Email"><%= s.email %></td>
            <td data-label="Subscribed"><%= h.formatDate(s.created_at) %></td>
            <td class="actions">
              <form action="/admin/subscribers/<%= s.id %>/delete" method="post" data-confirm="Remove this subscriber?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm btn--ghost btn--danger-text">Remove</button></form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %><p class="muted">No subscribers yet.</p><% } %>
</section>
<%- include('_bottom') %>
