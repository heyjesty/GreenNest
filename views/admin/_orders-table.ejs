<% if (orders.length) { %>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% orders.forEach(o => { %>
        <tr>
          <td data-label="Order"><strong><%= o.order_number %></strong></td>
          <td data-label="Customer"><%= o.customer_name %><small class="block muted"><%= o.email %></small></td>
          <td data-label="Date"><%= h.formatDate(o.created_at) %></td>
          <td data-label="Total"><%= h.money(o.total) %></td>
          <td data-label="Status"><span class="status status--<%= o.status %>"><%= o.status %></span></td>
          <td><a href="/admin/orders/<%= o.id %>" class="btn btn--sm">Manage</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } else { %><p class="muted">No orders yet.</p><% } %>
