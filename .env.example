# ---- Server ----
PORT=4000
NODE_ENV=development
# Long random string used to sign session cookies (change this!)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database (PostgreSQL / Neon) ----
# On Vercel this is set automatically by the Neon integration.
# Locally, `npx vercel env pull .env.local` downloads it, or paste it here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- First admin account (created by `npm run db:setup`) ----
ADMIN_NAME=GreenNest Admin
ADMIN_EMAIL=admin@greennest.com
ADMIN_PASSWORD=Admin@12345

# ---- Shop settings ----
CURRENCY_SYMBOL=$
FREE_SHIPPING_OVER=50
SHIPPING_FEE=5.99
