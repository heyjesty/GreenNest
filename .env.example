# ---- Server ----
PORT=4000
NODE_ENV=development
# Long random string used to sign session cookies (change this!)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=greennest

# ---- First admin account (created by `npm run db:setup`) ----
ADMIN_NAME=GreenNest Admin
ADMIN_EMAIL=admin@greennest.com
ADMIN_PASSWORD=Admin@12345

# ---- Shop settings ----
CURRENCY_SYMBOL=$
FREE_SHIPPING_OVER=50
SHIPPING_FEE=5.99
